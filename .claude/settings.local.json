{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "NotebookEdit(*)",
      "mcp__ide__*"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
